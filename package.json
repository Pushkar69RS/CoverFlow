{
  "name": "coverflow",
  "version": "1.0.0",
  "description": "Warranty and AMC Service Management System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test": "npm --workspace=backend test",
    "test:golden": "npm --workspace=backend run test:golden",
    "test:concurrency": "npm --workspace=backend run test:concurrency",
    "lint": "npm --workspace=backend run lint && npm --workspace=frontend run lint",
    "db:migrate": "npm --workspace=backend run db:migrate",
    "db:seed": "npm --workspace=backend run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
